# ================================
# 虚拟交易配置示例文件
# 复制此文件为 .env 并修改相关配置
# ================================

# --- Binance API 配置 (仍需要真实API密钥来获取市场数据) ---
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# --- 虚拟交易配置 ---
SIMULATION=true                        # 启用虚拟交易模式 (true/false)
SIMULATION_INITIAL_BALANCE=10000.0     # 虚拟交易初始资金(USDT)

# --- 交易对配置 ---
SYMBOLS=BNB/USDT

# --- 初始参数配置 (JSON格式) ---
# 可以为每个交易对设置不同的初始参数
INITIAL_PARAMS_JSON={"BNB/USDT": {"initial_base_price": 600.0, "initial_grid": 2.0}}

# --- 基础交易配置 ---
INITIAL_GRID=2.0                       # 默认网格大小(%)
MIN_TRADE_AMOUNT=20.0                  # 最小交易金额
INITIAL_PRINCIPAL=0.0                  # 初始资金(真实交易用)

# --- 理财功能 (虚拟交易模式下会被忽略) ---
ENABLE_SAVINGS_FUNCTION=false

# --- 推送通知配置 (可选) ---
PUSHPLUS_TOKEN=your_pushplus_token_here

# --- Web界面配置 (可选) ---
WEB_USER=admin
WEB_PASSWORD=your_password_here

# --- 代理配置 (可选) ---
# HTTP_PROXY=http://127.0.0.1:7890

# --- 高级策略配置 (JSON格式，可选) ---
GRID_PARAMS_JSON={}
GRID_CONTINUOUS_PARAMS_JSON={}
DYNAMIC_INTERVAL_PARAMS_JSON={}
ENABLE_VOLUME_WEIGHTING=true

# --- 理财精度配置 (JSON格式) ---
SAVINGS_PRECISIONS={"USDT": 2, "BNB": 6, "DEFAULT": 8}